  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "warn",
    "no-console": "off",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "eqeqeq": ["warn", "smart"],
    "curly": "warn",
    "no-var": "warn",
    "prefer-const": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "build*/",
    "dist/",
    "WebUI/vendor/",
    "WebUI/wasm/*.js",
    "*.min.js",
    "artifacts/"
